# Copy to .env and adjust if needed. The defaults match compose.yaml.

# Application database (started with `npm run db:up`).
DATABASE_URL="postgresql://registry:registry@localhost:5432/registry"

# Disposable database for integration and end-to-end tests. Its name must end
# in "_test": the test setup refuses to touch any other database.
TEST_DATABASE_URL="postgresql://registry:registry@localhost:5432/registry_test"

# The college's time zone, used for deadlines, "today" and displayed times.
APP_TIME_ZONE="Europe/London"

# Where uploaded submissions are stored. Created on first upload.
UPLOAD_DIR="./storage/uploads"

# Outgoing email: account activation and password resets. The defaults send
# to Mailpit from compose.yaml; read the messages at http://localhost:8025.
SMTP_HOST="localhost"
SMTP_PORT="1025"
MAIL_FROM="Student Registry <registry@college.example>"
# A real mail service would also need credentials:
# SMTP_USER=""
# SMTP_PASSWORD=""

# Sign-in (Better Auth). The secret signs session cookies.
# This value is for local development only: generate your own for anything
# else, e.g. with `openssl rand -base64 32`.
BETTER_AUTH_SECRET="local-development-only-secret-0123456789abcdef"
# The app's public address, used in the links of activation and reset emails.
BETTER_AUTH_URL="http://localhost:3000"
# Show the demo logins on the sign-in page. Never enable it in a real
# deployment.
SHOW_DEMO_ACCOUNTS="true"

# End-to-end tests only: where they read Mailpit's inbox, if not here.
# MAILPIT_URL="http://localhost:8025"
